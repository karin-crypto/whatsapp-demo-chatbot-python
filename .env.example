# Green API credentials — connects Claude to WhatsApp.
# 1. Copy this file to ".env":   cp .env.example .env
# 2. Open the ".env" file and paste the 4 values EXACTLY as they appear
#    in your Green API panel (https://console.green-api.com).
#    Do NOT wrap values in quotes, and do NOT commit the real ".env" file.

# Instance id, e.g. 1101000001
idInstance=

# Instance API token (a long secret string)
apiTokenInstance=

# API host for text/JSON requests, e.g. https://api.green-api.com
apiUrl=

# Media host for sending files, e.g. https://media.green-api.com
mediaUrl=
